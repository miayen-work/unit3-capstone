{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3AccessDocsBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::unit3-capstone-miayen-docs",
                "arn:aws:s3:::unit3-capstone-miayen-docs/*"
            ]
        }
    ]
}
